# ============================================================
# GEOPULSE - INTEGRATED ANALYTICS AND FINAL INSIGHTS
# ============================================================

import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
import os

print("GEOPULSE - INTEGRATED ANALYTICS")
print("=" * 60)

file_path = "../data/raw/GeoPulse_Cleaned_Data_Quality_FIXED.xlsx"

if not os.path.exists(file_path):
    file_path = "GeoPulse_Cleaned_Data_Quality_FIXED.xlsx"

# Load datasets
business = pd.read_excel(
    file_path,
    sheet_name="Businesses_dataset_20261111"
)

mobility = pd.read_excel(
    file_path,
    sheet_name="smart_mobility_dataset"
)

pedestrian = pd.read_excel(
    file_path,
    sheet_name="Bi-Annual_Pedestrian_Counts_202"
)

print("\nDATASET DIMENSIONS")

print("Businesses:", business.shape)
print("Mobility:", mobility.shape)
print("Pedestrian:", pedestrian.shape)

# Identify columns dynamically
def find_column(columns, keywords):

    for col in columns:

        if any(word in str(col).lower() for word in keywords):
            return col

    return None

borough_col = find_column(
    business.columns,
    ["borough", "district"]
)

vehicle_col = find_column(
    mobility.columns,
    ["vehicle_count", "vehicles"]
)

speed_col = find_column(
    mobility.columns,
    ["speed"]
)

emission_col = find_column(
    mobility.columns,
    ["emission"]
)

# Convert mobility numeric columns
for col in [vehicle_col, speed_col, emission_col]:

    if col:

        mobility[col] = pd.to_numeric(
            mobility[col],
            errors="coerce"
        )

# ------------------------------------------------------------
# 1. BUSINESS INSIGHTS
# ------------------------------------------------------------

print("\n1. BUSINESS INSIGHTS")

business_kpis = pd.DataFrame({
    "Metric": [
        "Total Businesses",
        "Total Business Columns"
    ],
    "Value": [
        len(business),
        len(business.columns)
    ]
})

if borough_col:

    business_kpis.loc[len(business_kpis)] = [
        "Unique Boroughs",
        business[borough_col].nunique()
    ]

display(business_kpis)

# Business distribution
if borough_col:

    borough_summary = (
        business.groupby(borough_col)
        .size()
        .reset_index(name="Business_Count")
    )

    borough_summary = borough_summary.sort_values(
        "Business_Count",
        ascending=False
    )

    display(borough_summary)

    plt.figure(figsize=(10, 5))

    sns.barplot(
        data=borough_summary,
        x=borough_col,
        y="Business_Count"
    )

    plt.title("Business Distribution Across Boroughs")
    plt.xticks(rotation=45)
    plt.tight_layout()
    plt.show()

# ------------------------------------------------------------
# 2. SMART MOBILITY INSIGHTS
# ------------------------------------------------------------

print("\n2. SMART MOBILITY INSIGHTS")

mobility_kpis = []

for label, col in [
    ("Total Mobility Records", None),
    ("Average Vehicle Count", vehicle_col),
    ("Average Traffic Speed", speed_col),
    ("Average Emission Level", emission_col)
]:

    if col is None:

        mobility_kpis.append({
            "Metric": label,
            "Value": len(mobility)
        })

    elif mobility[col].notna().any():

        mobility_kpis.append({
            "Metric": label,
            "Value": round(mobility[col].mean(), 2)
        })

mobility_summary = pd.DataFrame(mobility_kpis)

display(mobility_summary)

# ------------------------------------------------------------
# 3. PEDESTRIAN INSIGHTS
# ------------------------------------------------------------

print("\n3. PEDESTRIAN INSIGHTS")

pedestrian_numeric = pedestrian.select_dtypes(
    include=np.number
)

pedestrian_kpis = pd.DataFrame({
    "Metric": [
        "Total Pedestrian Records",
        "Numeric Count Columns",
        "Total Pedestrian Count Values"
    ],
    "Value": [
        len(pedestrian),
        len(pedestrian_numeric.columns),
        pedestrian_numeric.sum().sum()
    ]
})

display(pedestrian_kpis)

# ------------------------------------------------------------
# 4. INTEGRATED COMPARISON
# ------------------------------------------------------------

print("\n4. INTEGRATED DATASET COMPARISON")

comparison = pd.DataFrame({
    "Dataset": [
        "Business",
        "Smart Mobility",
        "Pedestrian"
    ],
    "Records": [
        len(business),
        len(mobility),
        len(pedestrian)
    ],
    "Columns": [
        len(business.columns),
        len(mobility.columns),
        len(pedestrian.columns)
    ]
})

display(comparison)

plt.figure(figsize=(9, 5))

sns.barplot(
    data=comparison,
    x="Dataset",
    y="Records"
)

plt.title("GeoPulse Dataset Record Comparison")
plt.ylabel("Number of Records")
plt.tight_layout()
plt.show()

# ------------------------------------------------------------
# 5. FINAL DATA QUALITY CHECK
# ------------------------------------------------------------

print("\n5. FINAL DATA QUALITY CHECK")

quality = []

for name, df in [
    ("Business", business),
    ("Mobility", mobility),
    ("Pedestrian", pedestrian)
]:

    quality.append({
        "Dataset": name,
        "Rows": len(df),
        "Columns": len(df.columns),
        "Missing_Values": df.isnull().sum().sum(),
        "Duplicate_Rows": df.duplicated().sum()
    })

quality_summary = pd.DataFrame(quality)

display(quality_summary)

# ------------------------------------------------------------
# 6. EXPORT DASHBOARD DATA
# ------------------------------------------------------------

output_folder = "../reports/eda_outputs"

os.makedirs(output_folder, exist_ok=True)

business_kpis.to_csv(
    output_folder + "/business_kpis.csv",
    index=False
)

mobility_summary.to_csv(
    output_folder + "/mobility_kpis.csv",
    index=False
)

pedestrian_kpis.to_csv(
    output_folder + "/pedestrian_kpis.csv",
    index=False
)

comparison.to_csv(
    output_folder + "/dataset_comparison.csv",
    index=False
)

quality_summary.to_csv(
    output_folder + "/final_data_quality.csv",
    index=False
)

if borough_col:

    borough_summary.to_csv(
        output_folder + "/final_borough_summary.csv",
        index=False
    )

print("\n" + "=" * 60)
print("GEOPULSE INTEGRATED ANALYSIS COMPLETED")
print("Dashboard-ready summary files exported.")
print("=" * 60)
