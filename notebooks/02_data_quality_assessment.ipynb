# ============================================================
# GEOPULSE - DATA QUALITY ASSESSMENT
# ============================================================

import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
import os

print("GEOPULSE - DATA QUALITY ASSESSMENT")
print("=" * 60)

# Load dataset
file_path = "../data/raw/GeoPulse_Cleaned_Data_Quality_FIXED.xlsx"

if not os.path.exists(file_path):
    file_path = "GeoPulse_Cleaned_Data_Quality_FIXED.xlsx"

excel = pd.ExcelFile(file_path)

datasets = {
    sheet: pd.read_excel(file_path, sheet_name=sheet)
    for sheet in excel.sheet_names
    if sheet not in ["DQ_Summary", "Field_Quality", "DQ_Findings"]
}

os.makedirs("../reports/eda_outputs", exist_ok=True)

# Overall quality assessment
quality_results = []

for name, df in datasets.items():

    print(f"\nDATASET: {name}")
    print("-" * 50)

    rows, columns = df.shape
    missing = df.isnull().sum().sum()
    duplicates = df.duplicated().sum()
    total_cells = rows * columns

    completeness = (
        100 - (missing / total_cells * 100)
        if total_cells > 0 else 0
    )

    quality_results.append({
        "Dataset": name,
        "Rows": rows,
        "Columns": columns,
        "Missing_Values": missing,
        "Duplicate_Rows": duplicates,
        "Completeness_Percentage": round(completeness, 2)
    })

    print("Shape:", df.shape)
    print("\nMissing Values:")
    print(df.isnull().sum()[df.isnull().sum() > 0])

    print("\nDuplicate Rows:", duplicates)
    print("\nData Types:")
    print(df.dtypes)

# Create quality summary
quality_df = pd.DataFrame(quality_results)

print("\nOVERALL DATA QUALITY REPORT")
display(quality_df)

quality_df.to_csv(
    "../reports/eda_outputs/data_quality_summary.csv",
    index=False
)

# Visualize missing values
for name, df in datasets.items():

    missing = df.isnull().sum()

    missing = missing[missing > 0]

    if len(missing) > 0:

        plt.figure(figsize=(12, 5))

        missing.sort_values(ascending=False).plot(kind="bar")

        plt.title(f"Missing Values - {name}")
        plt.ylabel("Number of Missing Values")
        plt.xticks(rotation=45, ha="right")

        plt.tight_layout()
        plt.show()

# Completeness comparison
plt.figure(figsize=(10, 5))

sns.barplot(
    data=quality_df,
    x="Dataset",
    y="Completeness_Percentage"
)

plt.title("Dataset Completeness Comparison")
plt.xticks(rotation=45, ha="right")
plt.ylim(0, 105)
plt.tight_layout()
plt.show()

# Display supplied data quality reports
for sheet in ["DQ_Summary", "Field_Quality", "DQ_Findings"]:

    if sheet in excel.sheet_names:

        print(f"\nSUPPLIED REPORT: {sheet}")

        report = pd.read_excel(file_path, sheet_name=sheet)

        display(report.head(20))

print("\nDATA QUALITY ASSESSMENT COMPLETED")
