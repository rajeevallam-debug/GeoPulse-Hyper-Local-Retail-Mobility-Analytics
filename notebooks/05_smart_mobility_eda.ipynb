# ============================================================
# GEOPULSE - SMART MOBILITY EXPLORATORY DATA ANALYSIS
# ============================================================

import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
import os

print("GEOPULSE - SMART MOBILITY ANALYSIS")
print("=" * 60)

file_path = "../data/raw/GeoPulse_Cleaned_Data_Quality_FIXED.xlsx"

if not os.path.exists(file_path):
    file_path = "GeoPulse_Cleaned_Data_Quality_FIXED.xlsx"

df = pd.read_excel(
    file_path,
    sheet_name="smart_mobility_dataset"
)

print("Dataset Shape:", df.shape)

print("\nColumn Information")
print(df.dtypes)

print("\nFirst 10 Records")
display(df.head(10))

# Identify columns
def find_column(columns, keywords):

    for col in columns:

        if any(word in str(col).lower() for word in keywords):
            return col

    return None

vehicle_col = find_column(df.columns, ["vehicle_count", "vehicles"])
speed_col = find_column(df.columns, ["speed"])
occupancy_col = find_column(df.columns, ["occupancy"])
accident_col = find_column(df.columns, ["accident"])
emission_col = find_column(df.columns, ["emission"])
weather_col = find_column(df.columns, ["weather"])
timestamp_col = find_column(df.columns, ["timestamp", "datetime", "date"])
lat_col = find_column(df.columns, ["latitude", "lat"])
lon_col = find_column(df.columns, ["longitude", "lon", "lng"])

print("\nDetected Mobility Columns")
print({
    "Vehicle Count": vehicle_col,
    "Speed": speed_col,
    "Occupancy": occupancy_col,
    "Accidents": accident_col,
    "Emissions": emission_col,
    "Weather": weather_col,
    "Timestamp": timestamp_col
})

# Convert detected numeric columns
numeric_columns = [
    vehicle_col,
    speed_col,
    occupancy_col,
    accident_col,
    emission_col
]

for col in numeric_columns:

    if col:
        df[col] = pd.to_numeric(df[col], errors="coerce")

# KPI summary
print("\nSMART MOBILITY KPIs")

for col in numeric_columns:

    if col:

        print(
            f"{col}:",
            "Average =", round(df[col].mean(), 2),
            "| Maximum =", df[col].max()
        )

# Traffic metric distributions
for col in numeric_columns:

    if col and df[col].notna().sum() > 0:

        plt.figure(figsize=(9, 5))

        sns.histplot(
            df[col].dropna(),
            kde=True
        )

        plt.title(f"Distribution of {col}")
        plt.xlabel(col)
        plt.tight_layout()
        plt.show()

# Weather analysis
if weather_col and speed_col:

    weather_summary = (
        df.groupby(weather_col)[speed_col]
        .mean()
        .sort_values(ascending=False)
    )

    print("\nAverage Traffic Speed by Weather")
    display(weather_summary.reset_index())

    weather_summary.plot(
        kind="bar",
        figsize=(9, 5)
    )

    plt.title("Average Traffic Speed by Weather")
    plt.ylabel("Average Speed")
    plt.xticks(rotation=45)
    plt.tight_layout()
    plt.show()

# Time-based analysis
if timestamp_col:

    df[timestamp_col] = pd.to_datetime(
        df[timestamp_col],
        errors="coerce"
    )

    df["Analysis_Hour"] = df[timestamp_col].dt.hour

    if vehicle_col:

        hourly = df.groupby("Analysis_Hour")[vehicle_col].mean()

        hourly.plot(
            kind="line",
            marker="o",
            figsize=(10, 5)
        )

        plt.title("Average Vehicle Count by Hour")
        plt.xlabel("Hour")
        plt.ylabel("Average Vehicle Count")
        plt.grid(True)
        plt.tight_layout()
        plt.show()

# Correlation analysis
available_numeric = df.select_dtypes(include=np.number)

if len(available_numeric.columns) >= 2:

    plt.figure(figsize=(10, 7))

    sns.heatmap(
        available_numeric.corr(),
        annot=True,
        cmap="coolwarm",
        fmt=".2f"
    )

    plt.title("Smart Mobility Correlation Matrix")
    plt.tight_layout()
    plt.show()

# Geographic speed analysis
if lat_col and lon_col and speed_col:

    geo = df.copy()

    geo[lat_col] = pd.to_numeric(geo[lat_col], errors="coerce")
    geo[lon_col] = pd.to_numeric(geo[lon_col], errors="coerce")

    geo = geo.dropna(
        subset=[lat_col, lon_col, speed_col]
    )

    plt.figure(figsize=(10, 7))

    scatter = plt.scatter(
        geo[lon_col],
        geo[lat_col],
        c=geo[speed_col],
        alpha=0.6
    )

    plt.colorbar(scatter, label="Traffic Speed")

    plt.title("Geographic Traffic Speed Distribution")
    plt.xlabel("Longitude")
    plt.ylabel("Latitude")
    plt.tight_layout()
    plt.show()

os.makedirs("../reports/eda_outputs", exist_ok=True)

df.to_csv(
    "../reports/eda_outputs/smart_mobility_analysis.csv",
    index=False
)

print("\nSMART MOBILITY ANALYSIS COMPLETED")
