    plt.xticks(rotation=45,ha='right'); plt.tight_layout(); plt.show


if lat and lon:
    coords=business[[lat,lon]].apply(pd.to_numeric,errors='coerce').dropna()
    coords=coords[coords[lat].between(-90,90)&coords[lon].between(-180,180)]
    print('Valid coordinate records:',len(coords))
    if len(coords):
        try:
            import folium
            mp=folium.Map([coords[lat].median(),coords[lon].median()],zoom_start=10)
            for _,r in coords.sample(min(1500,len(coords)),random_state=42).iterrows():
                folium.CircleMarker([r[lat],r[lon]],radius=2,fill=True).add_to(mp)
            display(mp)
        except ImportError: print('Install folium: !pip install folium')
else: print('No coordinate pair available; map skipped.')


out=REPORTS/'analysis_findings'; out.mkdir(parents=True,exist_ok=True)
if borough: by_borough.to_csv(out/'businesses_by_borough.csv',index=False)
if zipc: by_zip.to_csv(out/'businesses_by_zip.csv',index=False)


