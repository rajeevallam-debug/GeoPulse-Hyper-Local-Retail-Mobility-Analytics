from pathlib import Path
import pandas as pd, numpy as np, re, warnings
PROJECT_DIR = Path('/content/GeoPulse')
RAW = PROJECT_DIR/'data'/'raw'
PROCESSED = PROJECT_DIR/'data'/'processed'
REPORTS = PROJECT_DIR/'reports'
for p in [PROCESSED, REPORTS/'data_quality', REPORTS/'analysis_findings']:
    p.mkdir(parents=True, exist_ok=True)

def load_file(category, sheet_hint=None):
    folder = RAW/category
    files = sorted(list(folder.rglob('*.csv')) + list(folder.rglob('*.xlsx')) + list(folder.rglob('*.xls')))
    if not files:
        raise FileNotFoundError(f'No CSV/Excel file found in {folder}. Upload the source file there or update PROJECT_DIR.')
    path = files[0]
    print('Reading:', path)
    if path.suffix.lower() == '.csv':
        try: return pd.read_csv(path, low_memory=False)
        except UnicodeDecodeError: return pd.read_csv(path, encoding='latin1', low_memory=False)
    xls = pd.ExcelFile(path)
    print('Sheets:', xls.sheet_names)
    sheet = sheet_hint if sheet_hint in xls.sheet_names else xls.sheet_names[0]
    print('Selected sheet:', sheet)
    return pd.read_excel(path, sheet_name=sheet)

def clean_cols(df):
    x=df.copy()
    x.columns=(x.columns.astype(str).str.strip().str.replace(r'[\s\-]+','_',regex=True)
               .str.replace(r'[^0-9A-Za-z_%]','',regex=True))
    return x

def save_processed(df, category, filename):
    folder=PROCESSED/category
    folder.mkdir(parents=True,exist_ok=True)
    path=folder/filename
    df.to_csv(path,index=False)
    print('Saved',len(df),'rows to',path)
    return path


p=PROCESSED/'businesses'/'businesses_cleaned.csv'
business=pd.read_csv(p) if p.exists() else load_file('businesses','Businesses_dataset_20261111')
business=clean_cols(business)
display(business.head()); print(business.shape)


def findcol(df, candidates):
    d={c.lower():c for c in df.columns}
    return next((d[x.lower()] for x in candidates if x.lower() in d),None)
borough=findcol(business,['Borough'])
zipc=findcol(business,['ZIP_Code','Zip_Code','Postal_Code'])
name=findcol(business,['Business_Name','Name'])
lat=findcol(business,['Latitude']); lon=findcol(business,['Longitude'])
if borough:
    by_borough=business.groupby(borough,dropna=False).size().reset_index(name='Business_Records').sort_values('Business_Records',ascending=False)
    display(by_borough)
else: print('Borough column not found:',business.columns.tolist())


import matplotlif name:
    print('Rows:',len(business),'non-empty names:',business[name].notna().sum(),
          'distinct recorded names:',business[name].nunique())ib.pyplot as plt
if borough:
    ax=by_borough.plot(kind='bar',x=borough,y='Business_Records',legend=False,figsize=(10,5),title='Business Records by Borough')
    plt.xticks(rotation=45,ha='right'); plt.tight_layout(); plt.show()
if zipc:
