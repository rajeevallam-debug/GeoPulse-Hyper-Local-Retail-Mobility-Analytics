from pathlib import Path
import pandas as pd, numpy as np, re, warnings
PROJECT_DIR = Path('/content/GeoPulse')
RAW = PROJECT_DIR/'data'/'raw'
PROCESSED = PROJECT_DIR/'data'/'processed'
REPORTS = PROJECT_DIR/'reports'
for p in [PROCESSED, REPORTS/'data_quality', REPORTS/'analysis_findings']:
    p.mkdir(parents=True, exist_ok=True)

def load_file(category, sheet_hint=None):
    folder = RAW/category
    files = sorted(list(folder.rglob('*.csv')) + list(folder.rglob('*.xlsx')) + list(folder.rglob('*.xls')))
    if not files:
        raise FileNotFoundError(f'No CSV/Excel file found in {folder}. Upload the source file there or update PROJECT_DIR.')
    path = files[0]
    print('Reading:', path)
    if path.suffix.lower() == '.csv':
        try: return pd.read_csv(path, low_memory=False)
        except UnicodeDecodeError: return pd.read_csv(path, encoding='latin1', low_memory=False)
    xls = pd.ExcelFile(path)
    print('Sheets:', xls.sheet_names)
    sheet = sheet_hint if sheet_hint in xls.sheet_names else xls.sheet_names[0]
    print('Selected sheet:', sheet)
    return pd.read_excel(path, sheet_name=sheet)

def clean_cols(df):
    x=df.copy()
    x.columns=(x.columns.astype(str).str.strip().str.replace(r'[\s\-]+','_',regex=True)
               .str.replace(r'[^0-9A-Za-z_%]','',regex=True))
    return x

def save_processed(df, category, filename):
    folder=PROCESSED/category
    folder.mkdir(parents=True,exist_ok=True)
    path=folder/filename
    df.to_csv(path,index=False)
    print('Saved',len(df),'rows to',path)
    return path


business=clean_cols(load_file('businesses','Businesses_dataset_20261111'))
mobility=clean_cols(load_file('mobility'))
pedestrian=clean_cols(load_file('pedestrian_counts','Bi-Annual_Pedestrian_Counts_202'))


def basic_clean(df):
    before=len(df)
    out=df.dropna(axis=0,how='all').dropna(axis=1,how='all').drop_duplicates().copy()
    return out, {'input_rows':before,'output_rows':len(out),'duplicates_or_empty_rows_removed':before-len(out)}
business,b_log=basic_clean(business)
mobility,m_log=basic_clean(mobility)
pedestrian,p_log=basic_clean(pedestrian)
print(b_log,m_log,p_log)


def numeric_cast(df, cols):
    log={}
    for col in cols:
        if col in df:
            before=df[col].notna().sum()
            df[col]=pd.to_numeric(df[col],errors='coerce')
            log[col]=int(before-df[col].notna().sum())
    return df,log
business,b_cast=numeric_cast(business,['Latitude','Longitude'])
mobility,m_cast=numeric_cast(mobility,['Latitude','Longitude','Vehicle_Count','Traffic_Speed_kmh','Road_Occupancy_%','Emission_Levels_g_km'])
if 'Timestamp' in mobility:
    before=mobility['Timestamp'].notna().sum()
    mobility['Timestamp']=pd.to_datetime(mobility['Timestamp'],errors='coerce')
    print('Unparsed timestamps:',int(before-mobility['Timestamp'].notna().sum()))
print('Numeric conversion issues:',b_cast,m_cast)


# Flag invalid coordinates by setting only invalid coordinate pairs to missing.
for df in [business,mobility]:
    if {'Latitude','Longitude'}.issubset(df.columns):
        invalid=~df['Latitude'].between(-90,90) | ~df['Longitude'].between(-180,180)
        df.loc[invalid,['Latitude','Longitude']]=np.nan


# Unpivot historical pedestrian columns ending in _AM, _MD or _PM when present.
period_cols=[c for c in pedestrian if re.search(r'_(AM|MD|PM)$',str(c),flags=re.I)]
id_cols=[c for c in ['Borough','Street_Name','From_Street','To_Street'] if c in pedestrian]
if period_cols:
    pedestrian_long=pedestrian.melt(id_vars=id_cols,value_vars=period_cols,
                                    var_name='Survey_Time_Label',value_name='Pedestrian_Count')
    pedestrian_long['Time_Period']=pedestrian_long['Survey_Time_Label'].str.extract(r'(AM|MD|PM)$',expand=False).str.upper()
    pedestrian_long['Survey_Period']=pedestrian_long['Survey_Time_Label'].str.replace(r'_(AM|MD|PM)$','',regex=True)
    pedestrian_long['Pedestrian_Count']=pd.to_numeric(pedestrian_long['Pedestrian_Count'],errors='coerce')
else:
    pedestrian_long=pedestrian.copy()
    print('No expected _AM/_MD/_PM columns found; original layout retained.')


save_processed(business,'businesses','businesses_cleaned.csv')
save_processed(mobility,'mobility','mobility_cleaned.csv')
save_processed(pedestrian_long,'pedestrian_counts','pedestrian_counts_cleaned.csv')
pd.DataFrame([{'dataset':'businesses',**b_log,'numeric_cast_issues':str(b_cast)},
              {'dataset':'mobility',**m_log,'numeric_cast_issues':str(m_cast)},
              {'dataset':'pedestrian_counts',**p_log,'output_rows':len(pedestrian_long)}]
            ).to_csv(REPORTS/'data_quality'/'cleaning_log.csv',index=False)
