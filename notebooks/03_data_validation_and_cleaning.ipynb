# ============================================================
# GEOPULSE - DATA VALIDATION AND CLEANING
# ============================================================

import pandas as pd
import numpy as np
import os
import re

print("GEOPULSE - DATA VALIDATION AND CLEANING")
print("=" * 60)

file_path = "../data/raw/GeoPulse_Cleaned_Data_Quality_FIXED.xlsx"

if not os.path.exists(file_path):
    file_path = "GeoPulse_Cleaned_Data_Quality_FIXED.xlsx"

output_folder = "../data/processed"

os.makedirs(output_folder, exist_ok=True)

excel = pd.ExcelFile(file_path)

datasets = {
    sheet: pd.read_excel(file_path, sheet_name=sheet)
    for sheet in excel.sheet_names
    if sheet not in ["DQ_Summary", "Field_Quality", "DQ_Findings"]
}

cleaning_report = []

for name, df in datasets.items():

    print(f"\nPROCESSING: {name}")
    print("-" * 50)

    original_rows = len(df)

    # Standardize column names
    df.columns = [
        re.sub(
            r"_+",
            "_",
            re.sub(r"[^a-zA-Z0-9]+", "_", str(col).strip())
        ).strip("_")
        for col in df.columns
    ]

    # Remove exact duplicate rows
    duplicate_count = df.duplicated().sum()

    df = df.drop_duplicates()

    # Remove completely empty rows and columns
    df = df.dropna(how="all")
    df = df.dropna(axis=1, how="all")

    # Clean text values
    for col in df.select_dtypes(include="object").columns:

        df[col] = df[col].apply(
            lambda x: x.strip() if isinstance(x, str) else x
        )

    # Convert likely date/time columns
    for col in df.columns:

        if any(word in col.lower() for word in
               ["timestamp", "datetime", "date", "time"]):

            converted = pd.to_datetime(
                df[col],
                errors="coerce"
            )

            if converted.notna().sum() > 0:
                df[col] = converted

    # Identify possible coordinate columns
    for col in df.columns:

        if any(word in col.lower() for word in
               ["latitude", "longitude"]):

            df[col] = pd.to_numeric(
                df[col],
                errors="coerce"
            )

    # Coordinate validation
    for col in df.columns:

        if "latitude" in col.lower():

            invalid = ~df[col].between(-90, 90)

            df.loc[invalid, col] = np.nan

        elif "longitude" in col.lower():

            invalid = ~df[col].between(-180, 180)

            df.loc[invalid, col] = np.nan

    # Save cleaned dataset
    safe_name = re.sub(r"[^a-zA-Z0-9]+", "_", name)

    output_path = os.path.join(
        output_folder,
        safe_name + "_cleaned.csv"
    )

    df.to_csv(output_path, index=False)

    cleaning_report.append({
        "Dataset": name,
        "Original_Rows": original_rows,
        "Final_Rows": len(df),
        "Duplicates_Removed": duplicate_count,
        "Missing_Values_After_Cleaning": df.isnull().sum().sum(),
        "Final_Columns": len(df.columns)
    })

    print("Original Rows:", original_rows)
    print("Final Rows:", len(df))
    print("Duplicates Removed:", duplicate_count)
    print("Saved:", output_path)

# Cleaning summary
cleaning_df = pd.DataFrame(cleaning_report)

print("\nCLEANING SUMMARY")
display(cleaning_df)

cleaning_df.to_csv(
    "../reports/eda_outputs/data_cleaning_summary.csv",
    index=False
)

print("\nDATA VALIDATION AND CLEANING COMPLETED")
