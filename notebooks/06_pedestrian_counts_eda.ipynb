# ============================================================
# GEOPULSE - PEDESTRIAN COUNTS EXPLORATORY DATA ANALYSIS
# ============================================================

import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
import os

print("GEOPULSE - PEDESTRIAN COUNTS ANALYSIS")
print("=" * 60)

file_path = "../data/raw/GeoPulse_Cleaned_Data_Quality_FIXED.xlsx"

if not os.path.exists(file_path):
    file_path = "GeoPulse_Cleaned_Data_Quality_FIXED.xlsx"

df = pd.read_excel(
    file_path,
    sheet_name="Bi-Annual_Pedestrian_Counts_202"
)

print("Dataset Shape:", df.shape)

print("\nDataset Information")
print(df.info())

print("\nFirst 10 Records")
display(df.head(10))

# Identify descriptive columns
text_columns = df.select_dtypes(
    include=["object", "string"]
).columns.tolist()

print("\nText Columns:", text_columns)

# Identify potential pedestrian count columns
numeric_columns = df.select_dtypes(
    include=np.number
).columns.tolist()

print("\nNumeric Columns:", numeric_columns)

# Convert wide data into long format
# The original dataset contains multiple time-based columns.
id_columns = [
    col for col in df.columns
    if col not in numeric_columns
]

if not numeric_columns:

    print("No numeric pedestrian count columns detected.")

else:

    long_df = df.melt(
        id_vars=id_columns,
        value_vars=numeric_columns,
        var_name="Count_Period",
        value_name="Pedestrian_Count"
    )

    long_df["Pedestrian_Count"] = pd.to_numeric(
        long_df["Pedestrian_Count"],
        errors="coerce"
    )

    long_df = long_df.dropna(
        subset=["Pedestrian_Count"]
    )

    print("\nLONG FORMAT DATA")
    display(long_df.head(15))

    # Overall statistics
    print("\nPEDESTRIAN COUNT STATISTICS")

    print("Total Records:", len(long_df))
    print("Total Pedestrian Counts:", long_df["Pedestrian_Count"].sum())
    print("Average Count:", round(long_df["Pedestrian_Count"].mean(), 2))
    print("Maximum Count:", long_df["Pedestrian_Count"].max())

    # Top pedestrian count periods
    period_summary = (
        long_df.groupby("Count_Period")["Pedestrian_Count"]
        .sum()
        .sort_values(ascending=False)
    )

    print("\nTop Count Periods")
    display(period_summary.head(15).reset_index())

    plt.figure(figsize=(12, 5))

    period_summary.head(15).plot(kind="bar")

    plt.title("Top 15 Pedestrian Count Periods")
    plt.xlabel("Count Period")
    plt.ylabel("Pedestrian Count")
    plt.xticks(rotation=45, ha="right")
    plt.tight_layout()
    plt.show()

    # Pedestrian count distribution
    plt.figure(figsize=(9, 5))

    sns.histplot(
        long_df["Pedestrian_Count"],
        kde=True
    )

    plt.title("Pedestrian Count Distribution")
    plt.xlabel("Pedestrian Count")
    plt.tight_layout()
    plt.show()

    # Compare count periods using suffixes if present
    long_df["Time_Category"] = (
        long_df["Count_Period"]
        .astype(str)
        .str.extract(r"(_AM|_PM|_MD)$", expand=False)
    )

    if long_df["Time_Category"].notna().any():

        time_summary = (
            long_df.groupby("Time_Category")["Pedestrian_Count"]
            .mean()
        )

        print("\nAverage Pedestrian Count by Time Category")
        display(time_summary.reset_index())

        time_summary.plot(
            kind="bar",
            figsize=(8, 5)
        )

        plt.title("Pedestrian Activity by Time Category")
        plt.xlabel("Time Category")
        plt.ylabel("Average Pedestrian Count")
        plt.tight_layout()
        plt.show()

    # Export long-format dataset
    os.makedirs("../data/processed", exist_ok=True)

    long_df.to_csv(
        "../data/processed/pedestrian_counts_long.csv",
        index=False
    )

    period_summary.to_csv(
        "../reports/eda_outputs/pedestrian_period_summary.csv"
    )

print("\nPEDESTRIAN COUNTS ANALYSIS COMPLETED")
