# ============================================================
# GEOPULSE - DATA UNDERSTANDING
# ============================================================

import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
import os
import warnings

warnings.filterwarnings("ignore")

# Dataset path
FILE_PATH = "../data/raw/GeoPulse_Cleaned_Data_Quality_FIXED.xlsx"

# Load datasets
businesses = pd.read_excel(
    FILE_PATH,
    sheet_name="Businesses_dataset_20261111"
)

mobility = pd.read_excel(
    FILE_PATH,
    sheet_name="smart_mobility_dataset"
)

pedestrians = pd.read_excel(
    FILE_PATH,
    sheet_name="Bi-Annual_Pedestrian_Counts_202"
)

dq_summary = pd.read_excel(FILE_PATH, sheet_name="DQ_Summary")

field_quality = pd.read_excel(FILE_PATH, sheet_name="Field_Quality")

dq_findings = pd.read_excel(FILE_PATH, sheet_name="DQ_Findings")


# 1. Dataset overview
print("="*60)
print("GEOPULSE DATA UNDERSTANDING")
print("="*60)

datasets = {
    "Businesses": businesses,
    "Smart Mobility": mobility,
    "Pedestrian Counts": pedestrians
}

for name, df in datasets.items():

    print("\nDATASET:", name)

    print("Rows:", df.shape[0])
    print("Columns:", df.shape[1])

    print("\nColumn Names:")
    print(df.columns.tolist())

    print("\nData Types:")
    print(df.dtypes)

    print("\nFirst Five Records:")
    display(df.head())

    print("\nStatistical Summary:")
    display(df.describe(include="all").T)


# 2. Dataset dimensions comparison

dimension_data = pd.DataFrame({
    "Dataset": list(datasets.keys()),
    "Rows": [df.shape[0] for df in datasets.values()],
    "Columns": [df.shape[1] for df in datasets.values()]
})

display(dimension_data)


# 3. Dataset size visualization

plt.figure(figsize=(10,5))

sns.barplot(
    data=dimension_data,
    x="Dataset",
    y="Rows"
)

plt.title("GeoPulse Dataset Size Comparison")
plt.xlabel("Dataset")
plt.ylabel("Number of Records")
plt.xticks(rotation=15)
plt.tight_layout()
plt.show()


# 4. Column data type distribution

for name, df in datasets.items():

    dtype_counts = df.dtypes.astype(str).value_counts()

    plt.figure(figsize=(7,4))

    dtype_counts.plot(kind="bar")

    plt.title(f"{name} - Data Type Distribution")
    plt.xlabel("Data Type")
    plt.ylabel("Number of Columns")

    plt.tight_layout()
    plt.show()


# 5. Data quality sheets

print("\nDATA QUALITY SUMMARY")
display(dq_summary)

print("\nFIELD QUALITY")
display(field_quality.head(20))

print("\nDATA QUALITY FINDINGS")
display(dq_findings.head(20))


# 6. Final summary

print("\nGEOPULSE DATA UNDERSTANDING COMPLETED")

print("Total Analytical Records:",
      sum(len(df) for df in datasets.values()))

print("Total Analytical Columns:",
      sum(df.shape[1] for df in datasets.values()))
