# ============================================================
# GEOPULSE - BUSINESS GEOGRAPHIC EXPLORATORY DATA ANALYSIS
# ============================================================

import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
import os

print("GEOPULSE - BUSINESS GEOGRAPHIC ANALYSIS")
print("=" * 60)

file_path = "../data/raw/GeoPulse_Cleaned_Data_Quality_FIXED.xlsx"

if not os.path.exists(file_path):
    file_path = "GeoPulse_Cleaned_Data_Quality_FIXED.xlsx"

df = pd.read_excel(
    file_path,
    sheet_name="Businesses_dataset_20261111"
)

print("Dataset Shape:", df.shape)

print("\nDataset Information")
print(df.info())

print("\nFirst 10 Records")
display(df.head(10))

# Find columns automatically
def find_column(columns, keywords):

    for col in columns:

        if any(word in str(col).lower() for word in keywords):
            return col

    return None

borough_col = find_column(df.columns, ["borough", "district"])
zip_col = find_column(df.columns, ["zip", "postal"])
name_col = find_column(df.columns, ["business_name", "business name", "name"])
lat_col = find_column(df.columns, ["latitude", "lat"])
lon_col = find_column(df.columns, ["longitude", "lon", "lng"])

print("\nDetected Columns:")
print("Borough:", borough_col)
print("ZIP:", zip_col)
print("Business Name:", name_col)
print("Latitude:", lat_col)
print("Longitude:", lon_col)

# KPI calculations
print("\nBUSINESS KPIs")

print("Total Businesses:", len(df))

if borough_col:
    print("Unique Boroughs:", df[borough_col].nunique())

if zip_col:
    print("Unique ZIP Codes:", df[zip_col].nunique())

# Borough distribution
if borough_col:

    borough_counts = df[borough_col].value_counts()

    print("\nBusiness Distribution by Borough")
    display(borough_counts.reset_index())

    plt.figure(figsize=(10, 5))

    sns.barplot(
        x=borough_counts.index.astype(str),
        y=borough_counts.values
    )

    plt.title("Business Distribution by Borough")
    plt.xlabel("Borough")
    plt.ylabel("Number of Businesses")
    plt.xticks(rotation=45, ha="right")
    plt.tight_layout()
    plt.show()

# ZIP code concentration
if zip_col:

    zip_counts = df[zip_col].value_counts().head(10)

    plt.figure(figsize=(10, 5))

    sns.barplot(
        x=zip_counts.index.astype(str),
        y=zip_counts.values
    )

    plt.title("Top 10 ZIP Codes by Business Count")
    plt.xlabel("ZIP Code")
    plt.ylabel("Business Count")
    plt.xticks(rotation=45)
    plt.tight_layout()
    plt.show()

# Geographic distribution
if lat_col and lon_col:

    df[lat_col] = pd.to_numeric(df[lat_col], errors="coerce")
    df[lon_col] = pd.to_numeric(df[lon_col], errors="coerce")

    geo_df = df.dropna(subset=[lat_col, lon_col])

    geo_df = geo_df[
        geo_df[lat_col].between(-90, 90) &
        geo_df[lon_col].between(-180, 180)
    ]

    plt.figure(figsize=(10, 7))

    plt.scatter(
        geo_df[lon_col],
        geo_df[lat_col],
        alpha=0.4,
        s=8
    )

    plt.title("Geographic Distribution of Businesses")
    plt.xlabel("Longitude")
    plt.ylabel("Latitude")
    plt.tight_layout()
    plt.show()

# Business name frequency
if name_col:

    top_businesses = df[name_col].value_counts().head(10)

    print("\nTop 10 Repeated Business Names")
    display(top_businesses.reset_index())

# Export borough summary
if borough_col:

    borough_summary = (
        df.groupby(borough_col)
        .size()
        .reset_index(name="Business_Count")
    )

    os.makedirs("../reports/eda_outputs", exist_ok=True)

    borough_summary.to_csv(
        "../reports/eda_outputs/business_borough_summary.csv",
        index=False
    )

print("\nBUSINESS GEOGRAPHIC ANALYSIS COMPLETED")
